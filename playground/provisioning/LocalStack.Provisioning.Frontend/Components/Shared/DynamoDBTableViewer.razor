@using System.Globalization
@using Amazon.DynamoDBv2
@using Amazon.DynamoDBv2.Model

@inject IAmazonDynamoDB DynamoDb
@inject IJSRuntime Js
@implements IAsyncDisposable

<section class="panel" aria-labelledby="browser-heading">
    <div class="panel-heading">
        <h2 id="browser-heading">DynamoDB browser</h2>
        <span class="count-pill">@_items.Count</span>
        <div class="browser-toolbar">
            <select @bind="_selectedTable" @bind:after="RefreshAsync" aria-label="Table">
                @foreach (var table in _tables)
                {
                    <option value="@table">@table</option>
                }
            </select>
            <label class="auto-toggle" title="Refresh every @(AutoRefreshSeconds)s">
                <input type="checkbox" @bind="_autoRefresh" /> auto
            </label>
            <button type="button" class="secondary-button" @onclick="RefreshAsync">Refresh</button>
        </div>
    </div>

    @if (_error is not null)
    {
        <p class="panel-error" role="alert">@_error</p>
    }
    else if (_items.Count == 0)
    {
        <p class="empty-note">No items in @(_selectedTable ?? "this table").</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="raw-table">
                <thead>
                    <tr>
                        @foreach (var header in _headers)
                        {
                            <th>@header</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            @foreach (var header in _headers)
                            {
                                <td title="@(item.TryGetValue(header, out var full) ? FormatAttribute(full) : null)">
                                    @(item.TryGetValue(header, out var value) ? Truncate(FormatAttribute(value)) : "–")
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="browser-footer">Raw attributes · updated @(_lastUpdated?.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture) ?? "–")</p>
    }
</section>

@code {
    private const int MaxItems = 25;
    private const int AutoRefreshSeconds = 5;

    private readonly List<string> _tables = [];
    private List<Dictionary<string, AttributeValue>> _items = [];
    private List<string> _headers = [];
    private string? _selectedTable;
    private string? _error;
    private DateTimeOffset? _lastUpdated;
    private bool _autoRefresh = true;
    private PeriodicTimer? _timer;
    private IJSObjectReference? _visibilityModule;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tablesResponse = await DynamoDb.ListTablesAsync();
            _tables.AddRange(tablesResponse.TableNames);
            _selectedTable = _tables.FirstOrDefault();
            if (_selectedTable is not null)
            {
                await RefreshAsync();
            }
        }
        catch (AmazonDynamoDBException ex)
        {
            _error = $"DynamoDB error: {ex.Message}";
        }
        catch (HttpRequestException ex)
        {
            _error = $"Connection error: {ex.Message}";
        }

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(AutoRefreshSeconds));
        _ = AutoRefreshLoopAsync(_timer);
    }

    private async Task AutoRefreshLoopAsync(PeriodicTimer timer)
    {
        // Disposing the timer completes the pending tick with false, ending the loop without cancellation.
        while (await timer.WaitForNextTickAsync())
        {
            if (!_autoRefresh || await IsTabHiddenAsync())
            {
                continue;
            }

            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> IsTabHiddenAsync()
    {
        try
        {
            _visibilityModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/visibility.js");
            return await _visibilityModule.InvokeAsync<bool>("isHidden");
        }
        catch (JSException)
        {
            return false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_selectedTable is null)
        {
            return;
        }

        try
        {
            var response = await DynamoDb.ScanAsync(new ScanRequest { TableName = _selectedTable, Limit = MaxItems });
            _items = response.Items;
            _headers = _items
                .SelectMany(item => item.Keys)
                .Distinct(StringComparer.Ordinal)
                .OrderBy(key => key, StringComparer.Ordinal)
                .ToList();
            _error = null;
            _lastUpdated = DateTimeOffset.UtcNow;
        }
        catch (AmazonDynamoDBException ex)
        {
            _error = $"DynamoDB error: {ex.Message}";
        }
        catch (HttpRequestException ex)
        {
            _error = $"Connection error: {ex.Message}";
        }
    }

    private static string FormatAttribute(AttributeValue value)
    {
        if (value.S is not null)
        {
            return value.S;
        }

        if (value.N is not null)
        {
            return value.N;
        }

        if (value.IsBOOLSet)
        {
            return value.BOOL == true ? "true" : "false";
        }

        if (value.NULL == true)
        {
            return "null";
        }

        if (value.SS is { Count: > 0 })
        {
            return string.Join(", ", value.SS);
        }

        if (value.M is { Count: > 0 })
        {
            return $"map ({value.M.Count} keys)";
        }

        if (value.L is { Count: > 0 })
        {
            return $"list ({value.L.Count})";
        }

        if (value.B is not null)
        {
            return "binary";
        }

        return value.ToString() ?? "?";
    }

    private static string Truncate(string text) =>
        text.Length <= 48 ? text : $"{text[..45]}…";

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        if (_visibilityModule is not null)
        {
            try
            {
                await _visibilityModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone; nothing to release on the JS side.
                _visibilityModule = null;
            }
        }
    }
}
